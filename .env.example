# Copy to .env and fill in what the surface you are running needs:
#   cp .env.example .env
# This monorepo has three runnable surfaces — the MCP server (packages/mcp),
# the x402 service (packages/x402) and the dashboard (apps/dashboard). Each
# package README documents its own variables; this file collects them.
#
# Placeholder values only. Never commit a real secret key.

# ─── Shared ──────────────────────────────────────────────────────────────────
# Solana cluster endpoint. Defaults to devnet everywhere.
SOLANA_RPC=https://api.devnet.solana.com

# ─── MCP server (packages/mcp) and x402 service (packages/x402) ──────────────
# Comma-separated base58 operator secret keys the server is allowed to sign
# with. Nothing can be signed without this. Treat like cash.
KEYLESS_ESCROW_KEYS=

# ─── x402 service (packages/x402) ────────────────────────────────────────────
# Solana address that receives payments. Leave unset to run the paywall off,
# in dev mode.
X402_PAY_TO=
# CAIP-2 chain id. Defaults to Solana mainnet.
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_FACILITATOR=https://facilitator.x402.org
X402_OPEN_PRICE=$0.10
X402_SETTLE_PRICE=$0.05

# ─── Dashboard (apps/dashboard) ──────────────────────────────────────────────
# NOTE: the dashboard is custodial — the backend holds the keys. For a
# trust-free vault use the `program` or `presign` backend instead.
# Sign-in passcodes mapped to roles. SET THESE — they fall back to the
# well-known values "admin" and "mod" when unset.
ADMIN_PASSCODE=
MODERATOR_PASSCODE=
# Master wallet, base58 secret key; pays fees and Jito tips. Omit in dev and an
# ephemeral one is generated for you (you then have to fund it).
MASTER_SECRET=
# Wallet that funds admin-created escrows; must hold the mint. Base58 secret key.
BUYER_SECRET=
# JSON file holding escrow records, including escrow secret keys. Keep it out
# of the repo — .gitignore already excludes the default path.
DASHBOARD_STORE=.escrows.json

# ─── Ports ───────────────────────────────────────────────────────────────────
# Dashboard defaults to 4040, the x402 service to 4021.
PORT=

# ─── Examples (examples/program-devnet-lifecycle.ts) ─────────────────────────
# Override the deployed Anchor program id.
PROGRAM_ID=

# ─── Demo build (demo/vite.config.ts) ────────────────────────────────────────
# Public base path for the built demo, e.g. /solana-marketplace-escrow/.
VITE_BASE=/
# RPC the browser demo talks to.
VITE_SOLANA_RPC=https://api.devnet.solana.com
